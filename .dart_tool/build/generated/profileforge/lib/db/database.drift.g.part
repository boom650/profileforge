    map['university_name'] = Variable<String>(universityName);
    map['country'] = Variable<String>(country);
    map['major'] = Variable<String>(major);
    {
      map['category'] = Variable<String>(
          $AdmissionsProbabilitiesTable.$convertercategory.toSql(category));
    }
    map['reach_probability'] = Variable<double>(reachProbability);
    map['match_probability'] = Variable<double>(matchProbability);
    map['safety_probability'] = Variable<double>(safetyProbability);
    map['overall_probability'] = Variable<double>(overallProbability);
    {
      map['factors'] = Variable<String>(
          $AdmissionsProbabilitiesTable.$converterfactors.toSql(factors));
    }
    {
      map['strengths'] = Variable<String>(
          $AdmissionsProbabilitiesTable.$converterstrengths.toSql(strengths));
    }
    {
      map['weaknesses'] = Variable<String>(
          $AdmissionsProbabilitiesTable.$converterweaknesses.toSql(weaknesses));
    }
    {
      map['recommendations'] = Variable<String>($AdmissionsProbabilitiesTable
          .$converterrecommendations
          .toSql(recommendations));
    }
    if (!nullToAbsent || estimatedCost != null) {
      map['estimated_cost'] = Variable<int>(estimatedCost);
    }
    {
      map['scholarships'] = Variable<String>($AdmissionsProbabilitiesTable
          .$converterscholarships
          .toSql(scholarships));
    }
    if (!nullToAbsent || applicationDeadline != null) {
      map['application_deadline'] = Variable<int>(applicationDeadline);
    }
    map['application_status'] = Variable<String>(applicationStatus);
    if (!nullToAbsent || notes != null) {
      map['notes'] = Variable<String>(notes);
    }
    map['calculated_at'] = Variable<DateTime>(calculatedAt);
    map['created_at'] = Variable<DateTime>(createdAt);
    map['updated_at'] = Variable<DateTime>(updatedAt);
    return map;
  }

