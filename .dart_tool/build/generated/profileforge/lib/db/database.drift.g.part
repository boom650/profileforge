  String toString() {
    return (StringBuffer('OpportunityApplication(')
          ..write('id: $id, ')
          ..write('studentId: $studentId, ')
          ..write('opportunityId: $opportunityId, ')
          ..write('status: $status, ')
          ..write('applicationData: $applicationData, ')
