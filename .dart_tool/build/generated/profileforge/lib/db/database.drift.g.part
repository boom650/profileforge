class Opportunity extends DataClass implements Insertable<Opportunity> {
  final String id;
  final String title;
  final String description;
  final OpportunityCategory category;
  final OpportunityType type;
  final String organizer;
  final String? location;
  final bool isVirtual;
  final String? country;
  final String? city;
  final int startDate;
  final int endDate;
  final int applicationDeadline;
  final String eligibility;
  final String requirements;
  final String prizes;
  final String? website;
  final String? contactEmail;
  final String? contactPhone;
  final List<String> tags;
  final OpportunityDifficulty difficulty;
  final OpportunityPrestige prestige;
  final int applicationFee;
  final int? maxParticipants;
  final int currentApplicants;
  final int? minGrade;
  final int? maxGrade;
  final int? minAge;
  final int? maxAge;
  final double? requiredGpa;
  final Map<String, double> requiredTestScores;
  final List<String> requiredDocuments;
  final String selectionCriteria;
  final Map<String, String> timeline;
  final bool isActive;
  final bool isFeatured;
  final int views;
  final int applications;
  final String? imageUrl;
  final int createdAt;
  final int updatedAt;
  const Opportunity(
      {required this.id,
      required this.title,
      required this.description,
      required this.category,
      required this.type,
      required this.organizer,
      this.location,
      required this.isVirtual,
      this.country,
      this.city,
      required this.startDate,
      required this.endDate,
      required this.applicationDeadline,
      required this.eligibility,
      required this.requirements,
      required this.prizes,
      this.website,
      this.contactEmail,
      this.contactPhone,
      required this.tags,
      required this.difficulty,
      required this.prestige,
      required this.applicationFee,
      this.maxParticipants,
      required this.currentApplicants,
      this.minGrade,
      this.maxGrade,
      this.minAge,
      this.maxAge,
      this.requiredGpa,
      required this.requiredTestScores,
      required this.requiredDocuments,
      required this.selectionCriteria,
      required this.timeline,
      required this.isActive,
      required this.isFeatured,
      required this.views,
      required this.applications,
      this.imageUrl,
      required this.createdAt,
      required this.updatedAt});
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<String>(id);
    map['title'] = Variable<String>(title);
    map['description'] = Variable<String>(description);
    {
      map['category'] = Variable<String>(
          $OpportunitiesTable.$convertercategory.toSql(category));
    }
    {
      map['type'] =
          Variable<String>($OpportunitiesTable.$convertertype.toSql(type));
    }
    map['organizer'] = Variable<String>(organizer);
    if (!nullToAbsent || location != null) {
      map['location'] = Variable<String>(location);
    }
    map['is_virtual'] = Variable<bool>(isVirtual);
    if (!nullToAbsent || country != null) {
      map['country'] = Variable<String>(country);
    }
    if (!nullToAbsent || city != null) {
      map['city'] = Variable<String>(city);
    }
    map['start_date'] = Variable<int>(startDate);
    map['end_date'] = Variable<int>(endDate);
    map['application_deadline'] = Variable<int>(applicationDeadline);
    map['eligibility'] = Variable<String>(eligibility);
    map['requirements'] = Variable<String>(requirements);
    map['prizes'] = Variable<String>(prizes);
    if (!nullToAbsent || website != null) {
      map['website'] = Variable<String>(website);
    }
    if (!nullToAbsent || contactEmail != null) {
      map['contact_email'] = Variable<String>(contactEmail);
    }
    if (!nullToAbsent || contactPhone != null) {
      map['contact_phone'] = Variable<String>(contactPhone);
    }
    {
      map['tags'] =
          Variable<String>($OpportunitiesTable.$convertertags.toSql(tags));
    }
    {
      map['difficulty'] = Variable<String>(
          $OpportunitiesTable.$converterdifficulty.toSql(difficulty));
    }
    {
      map['prestige'] = Variable<String>(
          $OpportunitiesTable.$converterprestige.toSql(prestige));
    }
    map['application_fee'] = Variable<int>(applicationFee);
    if (!nullToAbsent || maxParticipants != null) {
      map['max_participants'] = Variable<int>(maxParticipants);
    }
    map['current_applicants'] = Variable<int>(currentApplicants);
    if (!nullToAbsent || minGrade != null) {
      map['min_grade'] = Variable<int>(minGrade);
    }
    if (!nullToAbsent || maxGrade != null) {
      map['max_grade'] = Variable<int>(maxGrade);
    }
    if (!nullToAbsent || minAge != null) {
      map['min_age'] = Variable<int>(minAge);
    }
    if (!nullToAbsent || maxAge != null) {
      map['max_age'] = Variable<int>(maxAge);
    }
    if (!nullToAbsent || requiredGpa != null) {
      map['required_gpa'] = Variable<double>(requiredGpa);
    }
    {
      map['required_test_scores'] = Variable<String>($OpportunitiesTable
          .$converterrequiredTestScores
          .toSql(requiredTestScores));
    }
    {
      map['required_documents'] = Variable<String>($OpportunitiesTable
          .$converterrequiredDocuments
          .toSql(requiredDocuments));
    }
    map['selection_criteria'] = Variable<String>(selectionCriteria);
    {
      map['timeline'] = Variable<String>(
          $OpportunitiesTable.$convertertimeline.toSql(timeline));
    }
    map['is_active'] = Variable<bool>(isActive);
    map['is_featured'] = Variable<bool>(isFeatured);
    map['views'] = Variable<int>(views);
    map['applications'] = Variable<int>(applications);
    if (!nullToAbsent || imageUrl != null) {
      map['image_url'] = Variable<String>(imageUrl);
    }
    map['created_at'] = Variable<int>(createdAt);
    map['updated_at'] = Variable<int>(updatedAt);
    return map;
  }

  OpportunitiesCompanion toCompanion(bool nullToAbsent) {
    return OpportunitiesCompanion(
      id: Value(id),
      title: Value(title),
      description: Value(description),
      category: Value(category),
      type: Value(type),
      organizer: Value(organizer),
      location: location == null && nullToAbsent
          ? const Value.absent()
          : Value(location),
      isVirtual: Value(isVirtual),
      country: country == null && nullToAbsent
          ? const Value.absent()
          : Value(country),
      city: city == null && nullToAbsent ? const Value.absent() : Value(city),
      startDate: Value(startDate),
      endDate: Value(endDate),
      applicationDeadline: Value(applicationDeadline),
      eligibility: Value(eligibility),
      requirements: Value(requirements),
      prizes: Value(prizes),
      website: website == null && nullToAbsent
          ? const Value.absent()
          : Value(website),
      contactEmail: contactEmail == null && nullToAbsent
          ? const Value.absent()
          : Value(contactEmail),
      contactPhone: contactPhone == null && nullToAbsent
          ? const Value.absent()
          : Value(contactPhone),
      tags: Value(tags),
      difficulty: Value(difficulty),
      prestige: Value(prestige),
      applicationFee: Value(applicationFee),
      maxParticipants: maxParticipants == null && nullToAbsent
          ? const Value.absent()
          : Value(maxParticipants),
      currentApplicants: Value(currentApplicants),
      minGrade: minGrade == null && nullToAbsent
          ? const Value.absent()
          : Value(minGrade),
      maxGrade: maxGrade == null && nullToAbsent
          ? const Value.absent()
          : Value(maxGrade),
      minAge:
          minAge == null && nullToAbsent ? const Value.absent() : Value(minAge),
      maxAge:
          maxAge == null && nullToAbsent ? const Value.absent() : Value(maxAge),
      requiredGpa: requiredGpa == null && nullToAbsent
          ? const Value.absent()
          : Value(requiredGpa),
      requiredTestScores: Value(requiredTestScores),
      requiredDocuments: Value(requiredDocuments),
      selectionCriteria: Value(selectionCriteria),
      timeline: Value(timeline),
      isActive: Value(isActive),
      isFeatured: Value(isFeatured),
      views: Value(views),
      applications: Value(applications),
      imageUrl: imageUrl == null && nullToAbsent
          ? const Value.absent()
          : Value(imageUrl),
      createdAt: Value(createdAt),
      updatedAt: Value(updatedAt),
    );
  }

  factory Opportunity.fromJson(Map<String, dynamic> json,
      {ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return Opportunity(
      id: serializer.fromJson<String>(json['id']),
      title: serializer.fromJson<String>(json['title']),
      description: serializer.fromJson<String>(json['description']),
      category: serializer.fromJson<OpportunityCategory>(json['category']),
