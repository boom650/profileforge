class Mission extends DataClass implements Insertable<Mission> {
  final String id;
  final String title;
  final String description;
  final MissionCategory category;
  final MissionType type;
  final MissionFrequency frequency;
  final int xpReward;
  final int coinReward;
  final int streakBonus;
  final MissionDifficulty difficulty;
  final String categoryId;
  final int requiredCount;
  final int currentProgress;
  final bool isActive;
  final bool isCompleted;
  final String? unlockCondition;
  final int unlockProgress;
  final int unlockTarget;
  final int startDate;
  final int? endDate;
  final String? icon;
  final String? color;
  final int sortOrder;
  final DateTime createdAt;
  final DateTime updatedAt;
  const Mission(
      {required this.id,
      required this.title,
      required this.description,
      required this.category,
      required this.type,
      required this.frequency,
      required this.xpReward,
      required this.coinReward,
      required this.streakBonus,
      required this.difficulty,
      required this.categoryId,
      required this.requiredCount,
      required this.currentProgress,
      required this.isActive,
      required this.isCompleted,
      this.unlockCondition,
      required this.unlockProgress,
      required this.unlockTarget,
      required this.startDate,
      this.endDate,
      this.icon,
      this.color,
      required this.sortOrder,
      required this.createdAt,
      required this.updatedAt});
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<String>(id);
    map['title'] = Variable<String>(title);
    map['description'] = Variable<String>(description);
    {
      map['category'] =
          Variable<String>($MissionsTable.$convertercategory.toSql(category));
    }
    {
      map['type'] = Variable<String>($MissionsTable.$convertertype.toSql(type));
    }
    {
      map['frequency'] =
          Variable<String>($MissionsTable.$converterfrequency.toSql(frequency));
    }
    map['xp_reward'] = Variable<int>(xpReward);
    map['coin_reward'] = Variable<int>(coinReward);
    map['streak_bonus'] = Variable<int>(streakBonus);
    {
      map['difficulty'] = Variable<String>(
          $MissionsTable.$converterdifficulty.toSql(difficulty));
    }
    map['category_id'] = Variable<String>(categoryId);
    map['required_count'] = Variable<int>(requiredCount);
    map['current_progress'] = Variable<int>(currentProgress);
    map['is_active'] = Variable<bool>(isActive);
    map['is_completed'] = Variable<bool>(isCompleted);
    if (!nullToAbsent || unlockCondition != null) {
      map['unlock_condition'] = Variable<String>(unlockCondition);
    }
    map['unlock_progress'] = Variable<int>(unlockProgress);
    map['unlock_target'] = Variable<int>(unlockTarget);
    map['start_date'] = Variable<int>(startDate);
    if (!nullToAbsent || endDate != null) {
      map['end_date'] = Variable<int>(endDate);
    }
    if (!nullToAbsent || icon != null) {
      map['icon'] = Variable<String>(icon);
    }
    if (!nullToAbsent || color != null) {
      map['color'] = Variable<String>(color);
    }
    map['sort_order'] = Variable<int>(sortOrder);
    map['created_at'] = Variable<DateTime>(createdAt);
    map['updated_at'] = Variable<DateTime>(updatedAt);
    return map;
  }

  MissionsCompanion toCompanion(bool nullToAbsent) {
    return MissionsCompanion(
      id: Value(id),
      title: Value(title),
      description: Value(description),
      category: Value(category),
      type: Value(type),
      frequency: Value(frequency),
      xpReward: Value(xpReward),
      coinReward: Value(coinReward),
      streakBonus: Value(streakBonus),
      difficulty: Value(difficulty),
      categoryId: Value(categoryId),
      requiredCount: Value(requiredCount),
      currentProgress: Value(currentProgress),
      isActive: Value(isActive),
      isCompleted: Value(isCompleted),
      unlockCondition: unlockCondition == null && nullToAbsent
          ? const Value.absent()
          : Value(unlockCondition),
      unlockProgress: Value(unlockProgress),
      unlockTarget: Value(unlockTarget),
      startDate: Value(startDate),
      endDate: endDate == null && nullToAbsent
          ? const Value.absent()
          : Value(endDate),
      icon: icon == null && nullToAbsent ? const Value.absent() : Value(icon),
      color:
          color == null && nullToAbsent ? const Value.absent() : Value(color),
      sortOrder: Value(sortOrder),
      createdAt: Value(createdAt),
      updatedAt: Value(updatedAt),
    );
  }

  factory Mission.fromJson(Map<String, dynamic> json,
      {ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return Mission(
      id: serializer.fromJson<String>(json['id']),
      title: serializer.fromJson<String>(json['title']),
      description: serializer.fromJson<String>(json['description']),
      category: serializer.fromJson<MissionCategory>(json['category']),
      type: serializer.fromJson<MissionType>(json['type']),
      frequency: serializer.fromJson<MissionFrequency>(json['frequency']),
      xpReward: serializer.fromJson<int>(json['xpReward']),
      coinReward: serializer.fromJson<int>(json['coinReward']),
      streakBonus: serializer.fromJson<int>(json['streakBonus']),
      difficulty: serializer.fromJson<MissionDifficulty>(json['difficulty']),
      categoryId: serializer.fromJson<String>(json['categoryId']),
      requiredCount: serializer.fromJson<int>(json['requiredCount']),
      currentProgress: serializer.fromJson<int>(json['currentProgress']),
      isActive: serializer.fromJson<bool>(json['isActive']),
      isCompleted: serializer.fromJson<bool>(json['isCompleted']),
      unlockCondition: serializer.fromJson<String?>(json['unlockCondition']),
      unlockProgress: serializer.fromJson<int>(json['unlockProgress']),
      unlockTarget: serializer.fromJson<int>(json['unlockTarget']),
      startDate: serializer.fromJson<int>(json['startDate']),
      endDate: serializer.fromJson<int?>(json['endDate']),
      icon: serializer.fromJson<String?>(json['icon']),
      color: serializer.fromJson<String?>(json['color']),
      sortOrder: serializer.fromJson<int>(json['sortOrder']),
      createdAt: serializer.fromJson<DateTime>(json['createdAt']),
      updatedAt: serializer.fromJson<DateTime>(json['updatedAt']),
    );
  }
  @override
  Map<String, dynamic> toJson({ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return <String, dynamic>{
      'id': serializer.toJson<String>(id),
      'title': serializer.toJson<String>(title),
      'description': serializer.toJson<String>(description),
      'category': serializer.toJson<MissionCategory>(category),
      'type': serializer.toJson<MissionType>(type),
      'frequency': serializer.toJson<MissionFrequency>(frequency),
      'xpReward': serializer.toJson<int>(xpReward),
      'coinReward': serializer.toJson<int>(coinReward),
