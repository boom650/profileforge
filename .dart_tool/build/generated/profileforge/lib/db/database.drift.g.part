  Opportunity copyWith(
          {String? id,
          String? title,
          String? description,
          OpportunityCategory? category,
          OpportunityType? type,
          String? organizer,
          Value<String?> location = const Value.absent(),
          bool? isVirtual,
          Value<String?> country = const Value.absent(),
          Value<String?> city = const Value.absent(),
          int? startDate,
          int? endDate,
          int? applicationDeadline,
          String? eligibility,
          String? requirements,
          String? prizes,
          Value<String?> website = const Value.absent(),
          Value<String?> contactEmail = const Value.absent(),
          Value<String?> contactPhone = const Value.absent(),
          List<String>? tags,
          OpportunityDifficulty? difficulty,
          OpportunityPrestige? prestige,
          int? applicationFee,
          Value<int?> maxParticipants = const Value.absent(),
          int? currentApplicants,
          Value<int?> minGrade = const Value.absent(),
          Value<int?> maxGrade = const Value.absent(),
          Value<int?> minAge = const Value.absent(),
          Value<int?> maxAge = const Value.absent(),
          Value<double?> requiredGpa = const Value.absent(),
          Map<String, double>? requiredTestScores,
          List<String>? requiredDocuments,
          String? selectionCriteria,
          Map<String, String>? timeline,
          bool? isActive,
          bool? isFeatured,
          int? views,
          int? applications,
          Value<String?> imageUrl = const Value.absent(),
          int? createdAt,
          int? updatedAt}) =>
      Opportunity(
        id: id ?? this.id,
        title: title ?? this.title,
        description: description ?? this.description,
        category: category ?? this.category,
        type: type ?? this.type,
        organizer: organizer ?? this.organizer,
        location: location.present ? location.value : this.location,
        isVirtual: isVirtual ?? this.isVirtual,
        country: country.present ? country.value : this.country,
        city: city.present ? city.value : this.city,
        startDate: startDate ?? this.startDate,
