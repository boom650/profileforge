        'teacher_verification': teacherVerification,
      if (skills != null) 'skills': skills,
      if (narrativeAngle != null) 'narrative_angle': narrativeAngle,
      if (admissionsValue != null) 'admissions_value': admissionsValue,
      if (isInSchool != null) 'is_in_school': isInSchool,
      if (location != null) 'location': location,
      if (totalHours != null) 'total_hours': totalHours,
      if (admissionsScore != null) 'admissions_score': admissionsScore,
      if (verificationStatus != null) 'verification_status': verificationStatus,
      if (verifiedAt != null) 'verified_at': verifiedAt,
      if (verifiedBy != null) 'verified_by': verifiedBy,
      if (createdAt != null) 'created_at': createdAt,
      if (updatedAt != null) 'updated_at': updatedAt,
      if (rowid != null) 'rowid': rowid,
    });
  }

