class Activity extends DataClass implements Insertable<Activity> {
  final String id;
  final String studentId;
  final String title;
  final ActivityCategory category;
  final ActivityTier tier;
  final String description;
  final int hoursPerWeek;
  final int weeksPerYear;
  final String? position;
  final String? organizationName;
  final String? gradeLevels;
  final bool isContinuousYearRound;
  final DateTime startDate;
  final DateTime? endDate;
  final String? evidence;
  final String? teacherVerification;
  final List<String> skills;
  final String? narrativeAngle;
  final int admissionsValue;
  final bool isInSchool;
  final String? location;
  final int totalHours;
  final int admissionsScore;
  final String verificationStatus;
  final DateTime? verifiedAt;
  final String? verifiedBy;
  final DateTime createdAt;
  final DateTime updatedAt;
  const Activity(
      {required this.id,
      required this.studentId,
      required this.title,
      required this.category,
      required this.tier,
      required this.description,
      required this.hoursPerWeek,
      required this.weeksPerYear,
      this.position,
      this.organizationName,
      this.gradeLevels,
      required this.isContinuousYearRound,
      required this.startDate,
      this.endDate,
      this.evidence,
      this.teacherVerification,
      required this.skills,
      this.narrativeAngle,
      required this.admissionsValue,
      required this.isInSchool,
      this.location,
      required this.totalHours,
      required this.admissionsScore,
      required this.verificationStatus,
      this.verifiedAt,
      this.verifiedBy,
      required this.createdAt,
      required this.updatedAt});
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<String>(id);
    map['student_id'] = Variable<String>(studentId);
    map['title'] = Variable<String>(title);
    {
      map['category'] =
          Variable<String>($ActivitiesTable.$convertercategory.toSql(category));
    }
    {
      map['tier'] =
          Variable<String>($ActivitiesTable.$convertertier.toSql(tier));
    }
    map['description'] = Variable<String>(description);
    map['hours_per_week'] = Variable<int>(hoursPerWeek);
    map['weeks_per_year'] = Variable<int>(weeksPerYear);
    if (!nullToAbsent || position != null) {
      map['position'] = Variable<String>(position);
    }
    if (!nullToAbsent || organizationName != null) {
      map['organization_name'] = Variable<String>(organizationName);
    }
    if (!nullToAbsent || gradeLevels != null) {
      map['grade_levels'] = Variable<String>(gradeLevels);
    }
    map['is_continuous_year_round'] = Variable<bool>(isContinuousYearRound);
    map['start_date'] = Variable<DateTime>(startDate);
    if (!nullToAbsent || endDate != null) {
      map['end_date'] = Variable<DateTime>(endDate);
    }
    if (!nullToAbsent || evidence != null) {
      map['evidence'] = Variable<String>(evidence);
    }
    if (!nullToAbsent || teacherVerification != null) {
      map['teacher_verification'] = Variable<String>(teacherVerification);
    }
    {
      map['skills'] =
          Variable<String>($ActivitiesTable.$converterskills.toSql(skills));
    }
    if (!nullToAbsent || narrativeAngle != null) {
      map['narrative_angle'] = Variable<String>(narrativeAngle);
    }
    map['admissions_value'] = Variable<int>(admissionsValue);
    map['is_in_school'] = Variable<bool>(isInSchool);
    if (!nullToAbsent || location != null) {
      map['location'] = Variable<String>(location);
    }
    map['total_hours'] = Variable<int>(totalHours);
    map['admissions_score'] = Variable<int>(admissionsScore);
    map['verification_status'] = Variable<String>(verificationStatus);
    if (!nullToAbsent || verifiedAt != null) {
      map['verified_at'] = Variable<DateTime>(verifiedAt);
    }
    if (!nullToAbsent || verifiedBy != null) {
      map['verified_by'] = Variable<String>(verifiedBy);
    }
    map['created_at'] = Variable<DateTime>(createdAt);
    map['updated_at'] = Variable<DateTime>(updatedAt);
    return map;
  }

  ActivitiesCompanion toCompanion(bool nullToAbsent) {
    return ActivitiesCompanion(
      id: Value(id),
      studentId: Value(studentId),
      title: Value(title),
      category: Value(category),
      tier: Value(tier),
      description: Value(description),
      hoursPerWeek: Value(hoursPerWeek),
      weeksPerYear: Value(weeksPerYear),
      position: position == null && nullToAbsent
          ? const Value.absent()
          : Value(position),
