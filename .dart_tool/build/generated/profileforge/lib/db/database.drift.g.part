      id: serializer.fromJson<String>(json['id']),
      name: serializer.fromJson<String>(json['name']),
      description: serializer.fromJson<String>(json['description']),
      rarity: serializer.fromJson<SkinRarity>(json['rarity']),
      category: serializer.fromJson<SkinCategory>(json['category']),
      assetPath: serializer.fromJson<String?>(json['assetPath']),
      previewPath: serializer.fromJson<String?>(json['previewPath']),
      unlockCondition: serializer.fromJson<String?>(json['unlockCondition']),
      unlockProgress: serializer.fromJson<int>(json['unlockProgress']),
      unlockTarget: serializer.fromJson<int>(json['unlockTarget']),
      isUnlocked: serializer.fromJson<bool>(json['isUnlocked']),
      isEquipped: serializer.fromJson<bool>(json['isEquipped']),
      sortOrder: serializer.fromJson<int>(json['sortOrder']),
      createdAt: serializer.fromJson<DateTime>(json['createdAt']),
      updatedAt: serializer.fromJson<DateTime>(json['updatedAt']),
