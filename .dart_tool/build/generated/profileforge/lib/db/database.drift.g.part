  static MultiTypedResultKey<$SkinCollectionsTable, List<SkinCollection>>
      _skinCollectionsRefsTable(_$AppDatabase db) =>
          MultiTypedResultKey.fromTable(db.skinCollections,
              aliasName:
                  $_aliasNameGenerator(db.skins.id, db.skinCollections.skinId));

  $$SkinCollectionsTableProcessedTableManager get skinCollectionsRefs {
    final manager =
        $$SkinCollectionsTableTableManager($_db, $_db.skinCollections)
            .filter((f) => f.skinId.id($_item.id));

    final cache =
        $_typedResult.readTableOrNull(_skinCollectionsRefsTable($_db));
    return ProcessedTableManager(
        manager.$state.copyWith(prefetchedData: cache));
