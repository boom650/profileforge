        lastActiveDate,
        currentSkinId,
        currentFrameId,
        equippedBadgesJson,
        createdAt,
        updatedAt
      ]);
  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      (other is StudentProfile &&
          other.id == this.id &&
          other.name == this.name &&
          other.email == this.email &&
          other.phone == this.phone &&
          other.board == this.board &&
          other.stream == this.stream &&
          other.grade == this.grade &&
          other.subjects == this.subjects &&
          other.tenthPercentage == this.tenthPercentage &&
          other.coachingInstitute == this.coachingInstitute &&
          other.coachingHoursPerWeek == this.coachingHoursPerWeek &&
          other.satScore == this.satScore &&
          other.ieltsScore == this.ieltsScore &&
          other.targetCountries == this.targetCountries &&
          other.targetMajor == this.targetMajor &&
          other.reachUniversities == this.reachUniversities &&
          other.matchUniversities == this.matchUniversities &&
          other.safetyUniversities == this.safetyUniversities &&
          other.totalXp == this.totalXp &&
          other.totalCoins == this.totalCoins &&
          other.currentStreak == this.currentStreak &&
          other.longestStreak == this.longestStreak &&
          other.lastActiveDate == this.lastActiveDate &&
          other.currentSkinId == this.currentSkinId &&
          other.currentFrameId == this.currentFrameId &&
          other.equippedBadgesJson == this.equippedBadgesJson &&
          other.createdAt == this.createdAt &&
