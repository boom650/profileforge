        currentApplicants: currentApplicants ?? this.currentApplicants,
        minGrade: minGrade.present ? minGrade.value : this.minGrade,
        maxGrade: maxGrade.present ? maxGrade.value : this.maxGrade,
        minAge: minAge.present ? minAge.value : this.minAge,
        maxAge: maxAge.present ? maxAge.value : this.maxAge,
        requiredGpa: requiredGpa.present ? requiredGpa.value : this.requiredGpa,
