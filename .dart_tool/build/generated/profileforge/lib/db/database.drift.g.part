class StudentProfile extends DataClass implements Insertable<StudentProfile> {
  final String id;
  final String name;
  final String email;
  final String phone;
  final String board;
  final String stream;
  final int grade;
  final Map<String, double> subjects;
  final double tenthPercentage;
  final String? coachingInstitute;
  final int coachingHoursPerWeek;
  final int? satScore;
  final double? ieltsScore;
  final List<String> targetCountries;
  final String? targetMajor;
  final List<String> reachUniversities;
  final List<String> matchUniversities;
  final List<String> safetyUniversities;
  final int totalXp;
  final int totalCoins;
  final int currentStreak;
  final int longestStreak;
  final int? lastActiveDate;
  final String? currentSkinId;
  final String? currentFrameId;
  final List<String> equippedBadgesJson;
  final DateTime createdAt;
  final DateTime updatedAt;
  const StudentProfile(
      {required this.id,
      required this.name,
      required this.email,
      required this.phone,
      required this.board,
      required this.stream,
      required this.grade,
      required this.subjects,
      required this.tenthPercentage,
      this.coachingInstitute,
      required this.coachingHoursPerWeek,
      this.satScore,
      this.ieltsScore,
      required this.targetCountries,
      this.targetMajor,
      required this.reachUniversities,
      required this.matchUniversities,
      required this.safetyUniversities,
      required this.totalXp,
      required this.totalCoins,
      required this.currentStreak,
      required this.longestStreak,
      this.lastActiveDate,
      this.currentSkinId,
      this.currentFrameId,
      required this.equippedBadgesJson,
      required this.createdAt,
      required this.updatedAt});
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<String>(id);
    map['name'] = Variable<String>(name);
    map['email'] = Variable<String>(email);
    map['phone'] = Variable<String>(phone);
    map['board'] = Variable<String>(board);
    map['stream'] = Variable<String>(stream);
    map['grade'] = Variable<int>(grade);
    {
      map['subjects'] = Variable<String>(
          $StudentProfilesTable.$convertersubjects.toSql(subjects));
    }
    map['tenth_percentage'] = Variable<double>(tenthPercentage);
    if (!nullToAbsent || coachingInstitute != null) {
      map['coaching_institute'] = Variable<String>(coachingInstitute);
    }
    map['coaching_hours_per_week'] = Variable<int>(coachingHoursPerWeek);
    if (!nullToAbsent || satScore != null) {
      map['sat_score'] = Variable<int>(satScore);
    }
    if (!nullToAbsent || ieltsScore != null) {
      map['ielts_score'] = Variable<double>(ieltsScore);
    }
    {
      map['target_countries'] = Variable<String>($StudentProfilesTable
          .$convertertargetCountries
          .toSql(targetCountries));
    }
    if (!nullToAbsent || targetMajor != null) {
      map['target_major'] = Variable<String>(targetMajor);
    }
    {
      map['reach_universities'] = Variable<String>($StudentProfilesTable
          .$converterreachUniversities
          .toSql(reachUniversities));
    }
    {
      map['match_universities'] = Variable<String>($StudentProfilesTable
          .$convertermatchUniversities
          .toSql(matchUniversities));
    }
    {
      map['safety_universities'] = Variable<String>($StudentProfilesTable
          .$convertersafetyUniversities
          .toSql(safetyUniversities));
    }
    map['total_xp'] = Variable<int>(totalXp);
    map['total_coins'] = Variable<int>(totalCoins);
    map['current_streak'] = Variable<int>(currentStreak);
    map['longest_streak'] = Variable<int>(longestStreak);
    if (!nullToAbsent || lastActiveDate != null) {
      map['last_active_date'] = Variable<int>(lastActiveDate);
    }
    if (!nullToAbsent || currentSkinId != null) {
      map['current_skin_id'] = Variable<String>(currentSkinId);
    }
    if (!nullToAbsent || currentFrameId != null) {
      map['current_frame_id'] = Variable<String>(currentFrameId);
    }
    {
      map['equipped_badges_json'] = Variable<String>($StudentProfilesTable
          .$converterequippedBadgesJson
          .toSql(equippedBadgesJson));
    }
    map['created_at'] = Variable<DateTime>(createdAt);
    map['updated_at'] = Variable<DateTime>(updatedAt);
    return map;
  }

  StudentProfilesCompanion toCompanion(bool nullToAbsent) {
    return StudentProfilesCompanion(
      id: Value(id),
      name: Value(name),
      email: Value(email),
      phone: Value(phone),
      board: Value(board),
      stream: Value(stream),
      grade: Value(grade),
      subjects: Value(subjects),
      tenthPercentage: Value(tenthPercentage),
      coachingInstitute: coachingInstitute == null && nullToAbsent
          ? const Value.absent()
          : Value(coachingInstitute),
      coachingHoursPerWeek: Value(coachingHoursPerWeek),
      satScore: satScore == null && nullToAbsent
          ? const Value.absent()
          : Value(satScore),
      ieltsScore: ieltsScore == null && nullToAbsent
          ? const Value.absent()
          : Value(ieltsScore),
      targetCountries: Value(targetCountries),
      targetMajor: targetMajor == null && nullToAbsent
          ? const Value.absent()
          : Value(targetMajor),
      reachUniversities: Value(reachUniversities),
      matchUniversities: Value(matchUniversities),
      safetyUniversities: Value(safetyUniversities),
      totalXp: Value(totalXp),
      totalCoins: Value(totalCoins),
      currentStreak: Value(currentStreak),
      longestStreak: Value(longestStreak),
      lastActiveDate: lastActiveDate == null && nullToAbsent
          ? const Value.absent()
          : Value(lastActiveDate),
      currentSkinId: currentSkinId == null && nullToAbsent
          ? const Value.absent()
          : Value(currentSkinId),
      currentFrameId: currentFrameId == null && nullToAbsent
          ? const Value.absent()
          : Value(currentFrameId),
      equippedBadgesJson: Value(equippedBadgesJson),
      createdAt: Value(createdAt),
      updatedAt: Value(updatedAt),
    );
  }

  factory StudentProfile.fromJson(Map<String, dynamic> json,
      {ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return StudentProfile(
      id: serializer.fromJson<String>(json['id']),
      name: serializer.fromJson<String>(json['name']),
