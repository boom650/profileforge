          prefetchHooksCallback: ({studentId = false, evidenceRefs = false}) {
            return PrefetchHooks(
              db: db,
              explicitlyWatchedTables: [if (evidenceRefs) db.evidence],
              addJoins: <
                  T extends TableManagerState<
                      dynamic,
