  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    if (id.present) {
      map['id'] = Variable<String>(id.value);
    }
    if (name.present) {
      map['name'] = Variable<String>(name.value);
    }
    if (email.present) {
      map['email'] = Variable<String>(email.value);
    }
    if (phone.present) {
      map['phone'] = Variable<String>(phone.value);
    }
    if (board.present) {
      map['board'] = Variable<String>(board.value);
    }
    if (stream.present) {
      map['stream'] = Variable<String>(stream.value);
    }
    if (grade.present) {
      map['grade'] = Variable<int>(grade.value);
    }
    if (subjects.present) {
      map['subjects'] = Variable<String>(
          $StudentProfilesTable.$convertersubjects.toSql(subjects.value));
    }
    if (tenthPercentage.present) {
      map['tenth_percentage'] = Variable<double>(tenthPercentage.value);
    }
    if (coachingInstitute.present) {
      map['coaching_institute'] = Variable<String>(coachingInstitute.value);
    }
    if (coachingHoursPerWeek.present) {
      map['coaching_hours_per_week'] =
          Variable<int>(coachingHoursPerWeek.value);
    }
    if (satScore.present) {
      map['sat_score'] = Variable<int>(satScore.value);
    }
    if (ieltsScore.present) {
      map['ielts_score'] = Variable<double>(ieltsScore.value);
    }
    if (targetCountries.present) {
      map['target_countries'] = Variable<String>($StudentProfilesTable
          .$convertertargetCountries
          .toSql(targetCountries.value));
    }
    if (targetMajor.present) {
      map['target_major'] = Variable<String>(targetMajor.value);
    }
    if (reachUniversities.present) {
      map['reach_universities'] = Variable<String>($StudentProfilesTable
          .$converterreachUniversities
          .toSql(reachUniversities.value));
    }
    if (matchUniversities.present) {
      map['match_universities'] = Variable<String>($StudentProfilesTable
          .$convertermatchUniversities
          .toSql(matchUniversities.value));
    }
    if (safetyUniversities.present) {
      map['safety_universities'] = Variable<String>($StudentProfilesTable
          .$convertersafetyUniversities
          .toSql(safetyUniversities.value));
    }
    if (totalXp.present) {
      map['total_xp'] = Variable<int>(totalXp.value);
    }
    if (totalCoins.present) {
      map['total_coins'] = Variable<int>(totalCoins.value);
    }
    if (currentStreak.present) {
      map['current_streak'] = Variable<int>(currentStreak.value);
    }
    if (longestStreak.present) {
      map['longest_streak'] = Variable<int>(longestStreak.value);
    }
    if (lastActiveDate.present) {
      map['last_active_date'] = Variable<int>(lastActiveDate.value);
    }
    if (currentSkinId.present) {
      map['current_skin_id'] = Variable<String>(currentSkinId.value);
    }
    if (currentFrameId.present) {
      map['current_frame_id'] = Variable<String>(currentFrameId.value);
    }
    if (equippedBadgesJson.present) {
      map['equipped_badges_json'] = Variable<String>($StudentProfilesTable
          .$converterequippedBadgesJson
          .toSql(equippedBadgesJson.value));
    }
    if (createdAt.present) {
      map['created_at'] = Variable<DateTime>(createdAt.value);
    }
    if (updatedAt.present) {
      map['updated_at'] = Variable<DateTime>(updatedAt.value);
    }
    if (rowid.present) {
      map['rowid'] = Variable<int>(rowid.value);
    }
    return map;
  }

  @override
  String toString() {
    return (StringBuffer('StudentProfilesCompanion(')
          ..write('id: $id, ')
          ..write('name: $name, ')
          ..write('email: $email, ')
          ..write('phone: $phone, ')
          ..write('board: $board, ')
          ..write('stream: $stream, ')
          ..write('grade: $grade, ')
          ..write('subjects: $subjects, ')
          ..write('tenthPercentage: $tenthPercentage, ')
          ..write('coachingInstitute: $coachingInstitute, ')
          ..write('coachingHoursPerWeek: $coachingHoursPerWeek, ')
          ..write('satScore: $satScore, ')
          ..write('ieltsScore: $ieltsScore, ')
          ..write('targetCountries: $targetCountries, ')
          ..write('targetMajor: $targetMajor, ')
          ..write('reachUniversities: $reachUniversities, ')
          ..write('matchUniversities: $matchUniversities, ')
          ..write('safetyUniversities: $safetyUniversities, ')
          ..write('totalXp: $totalXp, ')
          ..write('totalCoins: $totalCoins, ')
          ..write('currentStreak: $currentStreak, ')
          ..write('longestStreak: $longestStreak, ')
          ..write('lastActiveDate: $lastActiveDate, ')
          ..write('currentSkinId: $currentSkinId, ')
          ..write('currentFrameId: $currentFrameId, ')
          ..write('equippedBadgesJson: $equippedBadgesJson, ')
          ..write('createdAt: $createdAt, ')
          ..write('updatedAt: $updatedAt, ')
          ..write('rowid: $rowid')
          ..write(')'))
        .toString();
  }
}

