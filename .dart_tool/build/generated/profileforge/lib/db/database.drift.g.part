    return (StringBuffer('Skin(')
          ..write('id: $id, ')
          ..write('name: $name, ')
          ..write('description: $description, ')
          ..write('rarity: $rarity, ')
          ..write('category: $category, ')
          ..write('assetPath: $assetPath, ')
          ..write('previewPath: $previewPath, ')
          ..write('unlockCondition: $unlockCondition, ')
          ..write('unlockProgress: $unlockProgress, ')
          ..write('unlockTarget: $unlockTarget, ')
          ..write('isUnlocked: $isUnlocked, ')
          ..write('isEquipped: $isEquipped, ')
          ..write('sortOrder: $sortOrder, ')
          ..write('createdAt: $createdAt, ')
          ..write('updatedAt: $updatedAt')
          ..write(')'))
        .toString();
  }

  @override
  int get hashCode => Object.hash(
      id,
      name,
      description,
      rarity,
      category,
      assetPath,
      previewPath,
      unlockCondition,
      unlockProgress,
      unlockTarget,
      isUnlocked,
      isEquipped,
      sortOrder,
      createdAt,
      updatedAt);
  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      (other is Skin &&
          other.id == this.id &&
          other.name == this.name &&
          other.description == this.description &&
          other.rarity == this.rarity &&
          other.category == this.category &&
          other.assetPath == this.assetPath &&
          other.previewPath == this.previewPath &&
          other.unlockCondition == this.unlockCondition &&
          other.unlockProgress == this.unlockProgress &&
          other.unlockTarget == this.unlockTarget &&
          other.isUnlocked == this.isUnlocked &&
          other.isEquipped == this.isEquipped &&
