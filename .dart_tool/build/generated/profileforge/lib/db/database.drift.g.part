      identical(this, other) ||
      (other is OpportunityApplication &&
          other.id == this.id &&
          other.studentId == this.studentId &&
          other.opportunityId == this.opportunityId &&
          other.status == this.status &&
          other.applicationData == this.applicationData &&
          other.documents == this.documents &&
          other.notes == this.notes &&
          other.appliedAt == this.appliedAt &&
          other.respondedAt == this.respondedAt &&
          other.response == this.response &&
          other.reminderDaysBefore == this.reminderDaysBefore &&
          other.isReminderEnabled == this.isReminderEnabled &&
          other.createdAt == this.createdAt &&
          other.updatedAt == this.updatedAt);
}

