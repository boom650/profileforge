  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      (other is Opportunity &&
          other.id == this.id &&
          other.title == this.title &&
          other.description == this.description &&
          other.category == this.category &&
          other.type == this.type &&
          other.organizer == this.organizer &&
          other.location == this.location &&
          other.isVirtual == this.isVirtual &&
          other.country == this.country &&
          other.city == this.city &&
          other.startDate == this.startDate &&
          other.endDate == this.endDate &&
          other.applicationDeadline == this.applicationDeadline &&
          other.eligibility == this.eligibility &&
          other.requirements == this.requirements &&
          other.prizes == this.prizes &&
          other.website == this.website &&
          other.contactEmail == this.contactEmail &&
          other.contactPhone == this.contactPhone &&
          other.tags == this.tags &&
          other.difficulty == this.difficulty &&
          other.prestige == this.prestige &&
          other.applicationFee == this.applicationFee &&
          other.maxParticipants == this.maxParticipants &&
          other.currentApplicants == this.currentApplicants &&
          other.minGrade == this.minGrade &&
          other.maxGrade == this.maxGrade &&
          other.minAge == this.minAge &&
          other.maxAge == this.maxAge &&
          other.requiredGpa == this.requiredGpa &&
          other.requiredTestScores == this.requiredTestScores &&
          other.requiredDocuments == this.requiredDocuments &&
          other.selectionCriteria == this.selectionCriteria &&
          other.timeline == this.timeline &&
          other.isActive == this.isActive &&
          other.isFeatured == this.isFeatured &&
          other.views == this.views &&
          other.applications == this.applications &&
          other.imageUrl == this.imageUrl &&
          other.createdAt == this.createdAt &&
          other.updatedAt == this.updatedAt);
