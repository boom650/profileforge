      if (targetMajor != null) 'target_major': targetMajor,
      if (reachUniversities != null) 'reach_universities': reachUniversities,
      if (matchUniversities != null) 'match_universities': matchUniversities,
      if (safetyUniversities != null) 'safety_universities': safetyUniversities,
