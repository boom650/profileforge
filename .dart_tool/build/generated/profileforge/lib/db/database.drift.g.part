class OpportunityApplication extends DataClass
    implements Insertable<OpportunityApplication> {
  final String id;
  final String studentId;
  final String opportunityId;
  final String status;
  final Map<String, String> applicationData;
  final List<String> documents;
  final String? notes;
  final DateTime? appliedAt;
  final DateTime? respondedAt;
  final String? response;
  final int reminderDaysBefore;
  final bool isReminderEnabled;
  final DateTime createdAt;
  final DateTime updatedAt;
  const OpportunityApplication(
      {required this.id,
      required this.studentId,
      required this.opportunityId,
      required this.status,
      required this.applicationData,
      required this.documents,
      this.notes,
      this.appliedAt,
      this.respondedAt,
      this.response,
      required this.reminderDaysBefore,
      required this.isReminderEnabled,
      required this.createdAt,
      required this.updatedAt});
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<String>(id);
    map['student_id'] = Variable<String>(studentId);
    map['opportunity_id'] = Variable<String>(opportunityId);
    map['status'] = Variable<String>(status);
    {
      map['application_data'] = Variable<String>($OpportunityApplicationsTable
          .$converterapplicationData
          .toSql(applicationData));
    }
    {
      map['documents'] = Variable<String>(
          $OpportunityApplicationsTable.$converterdocuments.toSql(documents));
    }
    if (!nullToAbsent || notes != null) {
      map['notes'] = Variable<String>(notes);
    }
    if (!nullToAbsent || appliedAt != null) {
      map['applied_at'] = Variable<DateTime>(appliedAt);
    }
    if (!nullToAbsent || respondedAt != null) {
      map['responded_at'] = Variable<DateTime>(respondedAt);
    }
    if (!nullToAbsent || response != null) {
      map['response'] = Variable<String>(response);
    }
    map['reminder_days_before'] = Variable<int>(reminderDaysBefore);
    map['is_reminder_enabled'] = Variable<bool>(isReminderEnabled);
    map['created_at'] = Variable<DateTime>(createdAt);
    map['updated_at'] = Variable<DateTime>(updatedAt);
    return map;
  }

  OpportunityApplicationsCompanion toCompanion(bool nullToAbsent) {
    return OpportunityApplicationsCompanion(
      id: Value(id),
      studentId: Value(studentId),
      opportunityId: Value(opportunityId),
      status: Value(status),
      applicationData: Value(applicationData),
      documents: Value(documents),
      notes:
          notes == null && nullToAbsent ? const Value.absent() : Value(notes),
      appliedAt: appliedAt == null && nullToAbsent
          ? const Value.absent()
          : Value(appliedAt),
      respondedAt: respondedAt == null && nullToAbsent
          ? const Value.absent()
          : Value(respondedAt),
      response: response == null && nullToAbsent
          ? const Value.absent()
          : Value(response),
      reminderDaysBefore: Value(reminderDaysBefore),
      isReminderEnabled: Value(isReminderEnabled),
      createdAt: Value(createdAt),
      updatedAt: Value(updatedAt),
    );
  }

  factory OpportunityApplication.fromJson(Map<String, dynamic> json,
      {ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return OpportunityApplication(
      id: serializer.fromJson<String>(json['id']),
      studentId: serializer.fromJson<String>(json['studentId']),
      opportunityId: serializer.fromJson<String>(json['opportunityId']),
      status: serializer.fromJson<String>(json['status']),
      applicationData:
          serializer.fromJson<Map<String, String>>(json['applicationData']),
      documents: serializer.fromJson<List<String>>(json['documents']),
      notes: serializer.fromJson<String?>(json['notes']),
      appliedAt: serializer.fromJson<DateTime?>(json['appliedAt']),
      respondedAt: serializer.fromJson<DateTime?>(json['respondedAt']),
      response: serializer.fromJson<String?>(json['response']),
      reminderDaysBefore: serializer.fromJson<int>(json['reminderDaysBefore']),
      isReminderEnabled: serializer.fromJson<bool>(json['isReminderEnabled']),
      createdAt: serializer.fromJson<DateTime>(json['createdAt']),
      updatedAt: serializer.fromJson<DateTime>(json['updatedAt']),
    );
  }
  @override
  Map<String, dynamic> toJson({ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return <String, dynamic>{
      'id': serializer.toJson<String>(id),
      'studentId': serializer.toJson<String>(studentId),
      'opportunityId': serializer.toJson<String>(opportunityId),
      'status': serializer.toJson<String>(status),
      'applicationData':
          serializer.toJson<Map<String, String>>(applicationData),
      'documents': serializer.toJson<List<String>>(documents),
      'notes': serializer.toJson<String?>(notes),
      'appliedAt': serializer.toJson<DateTime?>(appliedAt),
      'respondedAt': serializer.toJson<DateTime?>(respondedAt),
      'response': serializer.toJson<String?>(response),
      'reminderDaysBefore': serializer.toJson<int>(reminderDaysBefore),
      'isReminderEnabled': serializer.toJson<bool>(isReminderEnabled),
      'createdAt': serializer.toJson<DateTime>(createdAt),
      'updatedAt': serializer.toJson<DateTime>(updatedAt),
    };
  }

