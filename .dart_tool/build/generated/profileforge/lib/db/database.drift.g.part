class Skin extends DataClass implements Insertable<Skin> {
  final String id;
  final String name;
  final String description;
  final SkinRarity rarity;
  final SkinCategory category;
  final String? assetPath;
  final String? previewPath;
  final String? unlockCondition;
  final int unlockProgress;
  final int unlockTarget;
  final bool isUnlocked;
  final bool isEquipped;
  final int sortOrder;
  final DateTime createdAt;
  final DateTime updatedAt;
  const Skin(
      {required this.id,
      required this.name,
      required this.description,
      required this.rarity,
      required this.category,
      this.assetPath,
      this.previewPath,
      this.unlockCondition,
      required this.unlockProgress,
      required this.unlockTarget,
      required this.isUnlocked,
      required this.isEquipped,
      required this.sortOrder,
      required this.createdAt,
      required this.updatedAt});
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<String>(id);
    map['name'] = Variable<String>(name);
    map['description'] = Variable<String>(description);
    {
      map['rarity'] =
          Variable<String>($SkinsTable.$converterrarity.toSql(rarity));
    }
    {
      map['category'] =
          Variable<String>($SkinsTable.$convertercategory.toSql(category));
    }
    if (!nullToAbsent || assetPath != null) {
      map['asset_path'] = Variable<String>(assetPath);
    }
    if (!nullToAbsent || previewPath != null) {
      map['preview_path'] = Variable<String>(previewPath);
    }
    if (!nullToAbsent || unlockCondition != null) {
      map['unlock_condition'] = Variable<String>(unlockCondition);
    }
    map['unlock_progress'] = Variable<int>(unlockProgress);
    map['unlock_target'] = Variable<int>(unlockTarget);
    map['is_unlocked'] = Variable<bool>(isUnlocked);
    map['is_equipped'] = Variable<bool>(isEquipped);
    map['sort_order'] = Variable<int>(sortOrder);
    map['created_at'] = Variable<DateTime>(createdAt);
    map['updated_at'] = Variable<DateTime>(updatedAt);
    return map;
  }

  SkinsCompanion toCompanion(bool nullToAbsent) {
    return SkinsCompanion(
      id: Value(id),
      name: Value(name),
      description: Value(description),
      rarity: Value(rarity),
      category: Value(category),
      assetPath: assetPath == null && nullToAbsent
          ? const Value.absent()
          : Value(assetPath),
      previewPath: previewPath == null && nullToAbsent
          ? const Value.absent()
          : Value(previewPath),
      unlockCondition: unlockCondition == null && nullToAbsent
          ? const Value.absent()
          : Value(unlockCondition),
      unlockProgress: Value(unlockProgress),
      unlockTarget: Value(unlockTarget),
      isUnlocked: Value(isUnlocked),
      isEquipped: Value(isEquipped),
      sortOrder: Value(sortOrder),
      createdAt: Value(createdAt),
      updatedAt: Value(updatedAt),
    );
  }

