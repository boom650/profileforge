  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    if (id.present) {
      map['id'] = Variable<String>(id.value);
    }
    if (studentId.present) {
      map['student_id'] = Variable<String>(studentId.value);
    }
    if (title.present) {
      map['title'] = Variable<String>(title.value);
    }
    if (category.present) {
      map['category'] = Variable<String>(
          $ActivitiesTable.$convertercategory.toSql(category.value));
    }
    if (tier.present) {
      map['tier'] =
          Variable<String>($ActivitiesTable.$convertertier.toSql(tier.value));
    }
    if (description.present) {
      map['description'] = Variable<String>(description.value);
    }
    if (hoursPerWeek.present) {
      map['hours_per_week'] = Variable<int>(hoursPerWeek.value);
    }
    if (weeksPerYear.present) {
      map['weeks_per_year'] = Variable<int>(weeksPerYear.value);
    }
    if (position.present) {
      map['position'] = Variable<String>(position.value);
    }
    if (organizationName.present) {
      map['organization_name'] = Variable<String>(organizationName.value);
    }
    if (gradeLevels.present) {
      map['grade_levels'] = Variable<String>(gradeLevels.value);
    }
    if (isContinuousYearRound.present) {
      map['is_continuous_year_round'] =
          Variable<bool>(isContinuousYearRound.value);
    }
    if (startDate.present) {
      map['start_date'] = Variable<DateTime>(startDate.value);
    }
    if (endDate.present) {
      map['end_date'] = Variable<DateTime>(endDate.value);
    }
    if (evidence.present) {
      map['evidence'] = Variable<String>(evidence.value);
    }
    if (teacherVerification.present) {
      map['teacher_verification'] = Variable<String>(teacherVerification.value);
    }
    if (skills.present) {
      map['skills'] = Variable<String>(
          $ActivitiesTable.$converterskills.toSql(skills.value));
    }
    if (narrativeAngle.present) {
      map['narrative_angle'] = Variable<String>(narrativeAngle.value);
    }
    if (admissionsValue.present) {
      map['admissions_value'] = Variable<int>(admissionsValue.value);
    }
    if (isInSchool.present) {
      map['is_in_school'] = Variable<bool>(isInSchool.value);
    }
    if (location.present) {
      map['location'] = Variable<String>(location.value);
    }
    if (totalHours.present) {
      map['total_hours'] = Variable<int>(totalHours.value);
    }
    if (admissionsScore.present) {
      map['admissions_score'] = Variable<int>(admissionsScore.value);
    }
    if (verificationStatus.present) {
      map['verification_status'] = Variable<String>(verificationStatus.value);
    }
    if (verifiedAt.present) {
      map['verified_at'] = Variable<DateTime>(verifiedAt.value);
    }
    if (verifiedBy.present) {
      map['verified_by'] = Variable<String>(verifiedBy.value);
    }
    if (createdAt.present) {
      map['created_at'] = Variable<DateTime>(createdAt.value);
    }
    if (updatedAt.present) {
      map['updated_at'] = Variable<DateTime>(updatedAt.value);
    }
    if (rowid.present) {
      map['rowid'] = Variable<int>(rowid.value);
    }
    return map;
  }

  @override
  String toString() {
    return (StringBuffer('ActivitiesCompanion(')
          ..write('id: $id, ')
          ..write('studentId: $studentId, ')
          ..write('title: $title, ')
          ..write('category: $category, ')
          ..write('tier: $tier, ')
          ..write('description: $description, ')
          ..write('hoursPerWeek: $hoursPerWeek, ')
          ..write('weeksPerYear: $weeksPerYear, ')
          ..write('position: $position, ')
          ..write('organizationName: $organizationName, ')
          ..write('gradeLevels: $gradeLevels, ')
          ..write('isContinuousYearRound: $isContinuousYearRound, ')
          ..write('startDate: $startDate, ')
          ..write('endDate: $endDate, ')
          ..write('evidence: $evidence, ')
          ..write('teacherVerification: $teacherVerification, ')
          ..write('skills: $skills, ')
          ..write('narrativeAngle: $narrativeAngle, ')
          ..write('admissionsValue: $admissionsValue, ')
          ..write('isInSchool: $isInSchool, ')
          ..write('location: $location, ')
          ..write('totalHours: $totalHours, ')
          ..write('admissionsScore: $admissionsScore, ')
          ..write('verificationStatus: $verificationStatus, ')
          ..write('verifiedAt: $verifiedAt, ')
          ..write('verifiedBy: $verifiedBy, ')
          ..write('createdAt: $createdAt, ')
          ..write('updatedAt: $updatedAt, ')
          ..write('rowid: $rowid')
          ..write(')'))
        .toString();
  }
}

