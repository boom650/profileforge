_$ATLLabImpl _$$ATLLabImplFromJson(Map<String, dynamic> json) => _$ATLLabImpl(
      labId: json['labId'] as String,
      schoolUdiseCode: json['schoolUdiseCode'] as String,
      schoolName: json['schoolName'] as String,
      schoolAddress: json['schoolAddress'] as String,
      city: json['city'] as String,
      district: json['district'] as String,
      state: json['state'] as String,
      pincode: json['pincode'] as String,
      latitude: (json['latitude'] as num?)?.toDouble(),
      longitude: (json['longitude'] as num?)?.toDouble(),
      phone: json['phone'] as String?,
      email: json['email'] as String?,
      website: json['website'] as String?,
      status: $enumDecode(_$ATLLabStatusEnumMap, json['status']),
      establishedDate: json['establishedDate'] as String?,
      inchargeName: json['inchargeName'] as String?,
      inchargePhone: json['inchargePhone'] as String?,
      inchargeEmail: json['inchargeEmail'] as String?,
      equipmentList: (json['equipmentList'] as List<dynamic>?)
          ?.map((e) => e as String)
          .toList(),
      programs: (json['programs'] as List<dynamic>?)
          ?.map((e) => e as String)
          .toList(),
      studentCapacity: (json['studentCapacity'] as num?)?.toInt(),
      currentEnrollment: (json['currentEnrollment'] as num?)?.toInt(),
      mentorsCount: (json['mentorsCount'] as num?)?.toInt(),
      projectsCompleted: (json['projectsCompleted'] as num?)?.toInt(),
      competitionsParticipated:
          (json['competitionsParticipated'] as num?)?.toInt(),
      awardsWon: (json['awardsWon'] as num?)?.toInt(),
      has3DPrinter: json['has3DPrinter'] as bool,
      hasArduino: json['hasArduino'] as bool,
      hasRaspberryPi: json['hasRaspberryPi'] as bool,
      hasDroneKit: json['hasDroneKit'] as bool,
      hasRoboticsKit: json['hasRoboticsKit'] as bool,
      hasElectronicsKit: json['hasElectronicsKit'] as bool,
      hasSensorsKit: json['hasSensorsKit'] as bool,
      hasMechanicalTools: json['hasMechanicalTools'] as bool,
      hasSolderingStation: json['hasSolderingStation'] as bool,
      hasVRAR: json['hasVRAR'] as bool,
      hasAIMLKit: json['hasAIMLKit'] as bool,
      hasIoTKit: json['hasIoTKit'] as bool,
      hasBiotechKit: json['hasBiotechKit'] as bool,
      hasAerospaceKit: json['hasAerospaceKit'] as bool,
      hasAutomotiveKit: json['hasAutomotiveKit'] as bool,
      labAreaSqft: json['labAreaSqft'] as String?,
      fundingAmount: json['fundingAmount'] as String?,
      fundingSource: json['fundingSource'] as String?,
      achievements: (json['achievements'] as List<dynamic>?)
          ?.map((e) => e as String)
          .toList(),
      studentProjects: (json['studentProjects'] as List<dynamic>?)
          ?.map((e) => e as String)
          .toList(),
      operatingHours: json['operatingHours'] as Map<String, dynamic>?,
      isOpenToCommunity: json['isOpenToCommunity'] as bool,
      hasMentorProgram: json['hasMentorProgram'] as bool,
      distanceKm: (json['distanceKm'] as num?)?.toDouble(),
      cachedAt: json['cachedAt'] == null
          ? null
          : DateTime.parse(json['cachedAt'] as String),
      source: json['source'] as String?,
    );

Map<String, dynamic> _$$ATLLabImplToJson(_$ATLLabImpl instance) =>
    <String, dynamic>{
      'labId': instance.labId,
      'schoolUdiseCode': instance.schoolUdiseCode,
      'schoolName': instance.schoolName,
      'schoolAddress': instance.schoolAddress,
      'city': instance.city,
      'district': instance.district,
      'state': instance.state,
      'pincode': instance.pincode,
      'latitude': instance.latitude,
      'longitude': instance.longitude,
      'phone': instance.phone,
      'email': instance.email,
      'website': instance.website,
      'status': _$ATLLabStatusEnumMap[instance.status]!,
      'establishedDate': instance.establishedDate,
      'inchargeName': instance.inchargeName,
      'inchargePhone': instance.inchargePhone,
      'inchargeEmail': instance.inchargeEmail,
      'equipmentList': instance.equipmentList,
      'programs': instance.programs,
      'studentCapacity': instance.studentCapacity,
      'currentEnrollment': instance.currentEnrollment,
      'mentorsCount': instance.mentorsCount,
      'projectsCompleted': instance.projectsCompleted,
      'competitionsParticipated': instance.competitionsParticipated,
      'awardsWon': instance.awardsWon,
      'has3DPrinter': instance.has3DPrinter,
      'hasArduino': instance.hasArduino,
      'hasRaspberryPi': instance.hasRaspberryPi,
      'hasDroneKit': instance.hasDroneKit,
      'hasRoboticsKit': instance.hasRoboticsKit,
      'hasElectronicsKit': instance.hasElectronicsKit,
      'hasSensorsKit': instance.hasSensorsKit,
      'hasMechanicalTools': instance.hasMechanicalTools,
      'hasSolderingStation': instance.hasSolderingStation,
      'hasVRAR': instance.hasVRAR,
      'hasAIMLKit': instance.hasAIMLKit,
      'hasIoTKit': instance.hasIoTKit,
      'hasBiotechKit': instance.hasBiotechKit,
      'hasAerospaceKit': instance.hasAerospaceKit,
      'hasAutomotiveKit': instance.hasAutomotiveKit,
      'labAreaSqft': instance.labAreaSqft,
      'fundingAmount': instance.fundingAmount,
      'fundingSource': instance.fundingSource,
      'achievements': instance.achievements,
      'studentProjects': instance.studentProjects,
      'operatingHours': instance.operatingHours,
      'isOpenToCommunity': instance.isOpenToCommunity,
      'hasMentorProgram': instance.hasMentorProgram,
      'distanceKm': instance.distanceKm,
      'cachedAt': instance.cachedAt?.toIso8601String(),
      'source': instance.source,
    };

const _$ATLLabStatusEnumMap = {
  ATLLabStatus.functional: 'functional',
  ATLLabStatus.nonFunctional: 'non_functional',
  ATLLabStatus.underSetup: 'under_setup',
  ATLLabStatus.proposed: 'proposed',
  ATLLabStatus.unknown: 'unknown',
};
