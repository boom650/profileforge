_$CompetitionImpl _$$CompetitionImplFromJson(Map<String, dynamic> json) =>
    _$CompetitionImpl(
      id: json['id'] as String,
      title: json['title'] as String,
      description: json['description'] as String,
      category: $enumDecode(_$CompetitionCategoryEnumMap, json['category']),
      level: $enumDecode(_$CompetitionLevelEnumMap, json['level']),
      startDate: DateTime.parse(json['startDate'] as String),
      endDate: DateTime.parse(json['endDate'] as String),
      registrationDeadline:
          DateTime.parse(json['registrationDeadline'] as String),
      registrationOpen: json['registrationOpen'] as bool,
      eligibleGrades: (json['eligibleGrades'] as List<dynamic>)
          .map((e) => (e as num).toInt())
          .toList(),
      eligibleStreams: (json['eligibleStreams'] as List<dynamic>)
          .map((e) => e as String)
          .toList(),
      isOnline: json['isOnline'] as bool,
      venue: json['venue'] as String?,
      city: json['city'] as String?,
      state: json['state'] as String?,
      country: json['country'] as String?,
      latitude: (json['latitude'] as num?)?.toDouble(),
      longitude: (json['longitude'] as num?)?.toDouble(),
      website: json['website'] as String?,
      registrationUrl: json['registrationUrl'] as String?,
      organizer: json['organizer'] as String,
      prizes:
          (json['prizes'] as List<dynamic>).map((e) => e as String).toList(),
      tags: (json['tags'] as List<dynamic>).map((e) => e as String).toList(),
      contactEmail: json['contactEmail'] as String?,
      contactPhone: json['contactPhone'] as String?,
      maxTeamSize: (json['maxTeamSize'] as num?)?.toInt(),
      minTeamSize: (json['minTeamSize'] as num?)?.toInt(),
      individualParticipation: json['individualParticipation'] as bool,
      teamParticipation: json['teamParticipation'] as bool,
      format: json['format'] as String?,
      syllabus: json['syllabus'] as String?,
      prerequisites: (json['prerequisites'] as List<dynamic>?)
          ?.map((e) => e as String)
          .toList(),
      rounds: json['rounds'] as Map<String, dynamic>?,
      resultDate: json['resultDate'] == null
          ? null
          : DateTime.parse(json['resultDate'] as String),
      cachedAt: DateTime.parse(json['cachedAt'] as String),
      source: json['source'] as String,
    );

Map<String, dynamic> _$$CompetitionImplToJson(_$CompetitionImpl instance) =>
    <String, dynamic>{
      'id': instance.id,
      'title': instance.title,
      'description': instance.description,
      'category': _$CompetitionCategoryEnumMap[instance.category]!,
      'level': _$CompetitionLevelEnumMap[instance.level]!,
      'startDate': instance.startDate.toIso8601String(),
      'endDate': instance.endDate.toIso8601String(),
      'registrationDeadline': instance.registrationDeadline.toIso8601String(),
      'registrationOpen': instance.registrationOpen,
      'eligibleGrades': instance.eligibleGrades,
      'eligibleStreams': instance.eligibleStreams,
      'isOnline': instance.isOnline,
      'venue': instance.venue,
      'city': instance.city,
      'state': instance.state,
      'country': instance.country,
      'latitude': instance.latitude,
      'longitude': instance.longitude,
      'website': instance.website,
      'registrationUrl': instance.registrationUrl,
      'organizer': instance.organizer,
      'prizes': instance.prizes,
      'tags': instance.tags,
      'contactEmail': instance.contactEmail,
      'contactPhone': instance.contactPhone,
      'maxTeamSize': instance.maxTeamSize,
      'minTeamSize': instance.minTeamSize,
      'individualParticipation': instance.individualParticipation,
      'teamParticipation': instance.teamParticipation,
      'format': instance.format,
      'syllabus': instance.syllabus,
      'prerequisites': instance.prerequisites,
      'rounds': instance.rounds,
      'resultDate': instance.resultDate?.toIso8601String(),
      'cachedAt': instance.cachedAt.toIso8601String(),
      'source': instance.source,
    };

