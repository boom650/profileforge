      hasFellowshipOpportunities: json['hasFellowshipOpportunities'] as bool,
      registrationNumber: json['registrationNumber'] as String?,
      registrationDate: json['registrationDate'] as String?,
      fcrNumber: json['fcrNumber'] as String?,
      panNumber: json['panNumber'] as String?,
      gstNumber: json['gstNumber'] as String?,
      establishedYear: (json['establishedYear'] as num?)?.toInt(),
      annualBudget: json['annualBudget'] as String?,
      keyProjects: (json['keyProjects'] as List<dynamic>?)
          ?.map((e) => e as String)
          .toList(),
      contactPersons: json['contactPersons'] as Map<String, dynamic>?,
      distanceKm: (json['distanceKm'] as num?)?.toDouble(),
      cachedAt: json['cachedAt'] == null
          ? null
          : DateTime.parse(json['cachedAt'] as String),
      source: json['source'] as String?,
    );

